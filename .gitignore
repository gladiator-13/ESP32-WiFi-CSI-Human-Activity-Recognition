# Ignore all contents of data/ by default
data/*

# Keep only the small index/metadata/error CSVs inside data/processed/
!data/processed/
data/processed/*
!data/processed/dataset_index.csv
!data/processed/metadata.csv
!data/processed/preprocessing_errors.csv

# Mac archive junk anywhere in the project
__MACOSX/
._*
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# VS Code
.vscode/

# Temporary files
*.log
Thumbs.db
